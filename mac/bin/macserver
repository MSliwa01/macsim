#!/bin/bash
# Toggle the Mac between "my laptop" and "always-on iOS build/Simulator server" for macsim.
#   macserver on      keep awake even with the lid closed (plug in the charger!)
#   macserver off     normal sleep behaviour
#   macserver status  sleep state, proxy, simulators, disk
#   macserver restart restart the agent-device proxy, its daemon and the XCUITest runner
#                     (clears sessions left behind by agents that never closed them)
set -u
LABEL=com.macsim.proxy
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
dom="gui/$(id -u)"

proxy_up() { launchctl print "$dom/$LABEL" >/dev/null 2>&1 || launchctl bootstrap "$dom" "$PLIST"; }

case "${1:-status}" in
  on)
    sudo pmset -a disablesleep 1 && echo "sleep disabled. The Mac stays reachable with the lid closed."
    proxy_up; echo "proxy running" ;;
  off)
    sudo pmset -a disablesleep 0 && echo "sleep enabled again" ;;
  restart)
    # The proxy reuses a running daemon, and the daemon keeps its sessions (idle timeout is off),
    # so a session whose client is gone holds the simulator until the daemon itself restarts.
    pkill -f "$HOME/.macsim/tools/node_modules/agent-device/dist/src/internal/daemon.js" 2>/dev/null
    pkill -f 'AgentDeviceRunnerUITests' 2>/dev/null
    proxy_up; launchctl kickstart -k "$dom/$LABEL" && echo "proxy, daemon and runner restarted" ;;
  status)
    echo "sleep disabled: $(pmset -g | awk '/SleepDisabled/{v=$2} END{print v+0}')"
    if launchctl print "$dom/$LABEL" 2>/dev/null | grep -q 'state = running'; then echo "proxy: running"; else echo "proxy: NOT running (see ~/.macsim/logs/proxy.log)"; fi
    echo "booted simulators: $(xcrun simctl list devices booted 2>/dev/null | grep -c Booted)"
    # Older installs keep projects in ~/builds, newer ones in ~/.macsim/builds. Show each that exists.
    builds=""
    for d in builds .macsim/builds; do
      [ -d "$HOME/$d" ] && builds="$builds   ~/$d: $(du -sh "$HOME/$d" 2>/dev/null | cut -f1)"
    done
    echo "disk free: $(df -h "$HOME" | awk 'NR==2{print $4}')$builds" ;;
  *) echo "usage: macserver on|off|status|restart" >&2; exit 1 ;;
esac
